# Copy this file to .env and adjust the paths/models to match your system.

# Whisper model size (auto-downloaded by faster-whisper)
WHISPER_MODEL_SIZE=small

# Piper configuration
# Absolute path to the Piper executable for your OS
PIPER_BIN=/absolute/path/to/piper
# Path to the Piper Bengali voice model (.onnx)
PIPER_MODEL=/absolute/path/to/bengali.onnx
# Path to the Piper model config (.json)
PIPER_CONFIG=/absolute/path/to/bengali.json

# Optional output directories
AUDIO_INPUT_DIR=./data/audio
AUDIO_OUTPUT_DIR=./data/audio
